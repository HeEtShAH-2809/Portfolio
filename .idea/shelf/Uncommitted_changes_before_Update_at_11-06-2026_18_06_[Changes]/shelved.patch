+/* GENERAL CONTENT SECTION BASE */
 .content-section {
     padding: 90px 0;
     border-bottom: 1px solid var(--border-dark);
+    position: relative;
+    overflow: hidden;
+}
+
+/* MINIMALIST STAR CONSTELLATIONS (Inverted to sharp midnight dots) */
+.content-section::before {
+    content: '';
+    position: absolute;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 100%;
+    /* Micro radial points acting as a crisp celestial map layout on white */
+    background-image:
+        radial-gradient(1px 1px at 12% 18%, rgba(0, 0, 0, 0.6) 100%, transparent),
+        radial-gradient(1.5px 1.5px at 38% 74%, rgba(0, 0, 0, 0.5) 100%, transparent),
+        radial-gradient(1px 1px at 56% 32%, rgba(0, 0, 0, 0.4) 100%, transparent),
+        radial-gradient(2px 2px at 72% 15%, rgba(0, 0, 0, 0.55) 100%, transparent),
+        radial-gradient(1px 1px at 89% 62%, rgba(0, 0, 0, 0.4) 100%, transparent),
+        radial-gradient(1.5px 1.5px at 25% 48%, rgba(15, 30, 90, 0.5) 100%, transparent),
+        radial-gradient(1px 1px at 68% 85%, rgba(120, 10, 10, 0.45) 100%, transparent);
+    background-size: 380px 380px;
+    opacity: 0;
+    z-index: 1;
+    transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1);
+    pointer-events: none;
+}
+
+/* AMBIENT GLOW BACKDROP (Balanced perfectly for white background blending) */
+.content-section::after {
+    content: '';
+    position: absolute;
+    top: 50%;
+    left: 50%;
+    transform: translate(-50%, -50%) scale(0.8);
+    width: 700px;
+    height: 500px;
+    background: radial-gradient(
+        ellipse,
+        rgba(224, 30, 30, 0.12) 0%,   /* Soft crimson core */
+        rgba(75, 15, 90, 0.08) 50%,   /* Delicate purple horizon aura */
+        rgba(255, 255, 255, 0) 80%    /* Fades beautifully out into solid white */
+    );
+    filter: blur(50px);
+    -webkit-filter: blur(50px);
+    border-radius: 50%;
+    opacity: 0;
+    z-index: 2;
+    transition: opacity 0.8s ease, transform 0.8s ease;
+    pointer-events: none;
+}
+
+/* GLOBAL SECTION HOVER COMBINATION */
+.content-section:hover::before {
+    opacity: 1;
+    animation: stellarTwinkle 5s infinite ease-in-out;
+}
+.content-section:hover::after {
+    opacity: 1;
+    transform: translate(-50%, -50%) scale(1.1);
 }
 
